<Window x:Class="AnovaApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnovaApp.Desktop"
        xmlns:controls="clr-namespace:AnovaApp.Desktop.Controls"
        xmlns:vm="clr-namespace:AnovaApp.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ANOVA Application"
        Width="1280" Height="840" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        AllowDrop="True">

  <Window.Resources>
    <local:VisibleWhenConverter x:Key="VisibleWhen" />
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveDataCommand}" />
    <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportReportCommand}" />
    <KeyBinding Key="V" Modifiers="Control+Shift" Command="{Binding PasteCommand}" />
  </Window.InputBindings>

  <Grid Margin="28,18,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenCommand}" ToolTip="Open a CSV file (Ctrl+O)" AutomationProperties.AutomationId="OpenButton">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Margin="0,0,8,0" />
            <TextBlock Text="Open" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ToolbarButton}" Command="{Binding PasteCommand}" ToolTip="Paste cells copied from a spreadsheet (Ctrl+Shift+V)" AutomationProperties.AutomationId="PasteButton">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" Margin="0,0,8,0" />
            <TextBlock Text="Paste" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveDataCommand}" ToolTip="Save the measurements as CSV (Ctrl+S)" AutomationProperties.AutomationId="SaveButton">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,8,0" />
            <TextBlock Text="Save data" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ToolbarButton}" Command="{Binding LoadSampleCommand}" ToolTip="Load example measurements" AutomationProperties.AutomationId="SampleButton">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Margin="0,0,8,0" />
            <TextBlock Text="Sample" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearCommand}" ToolTip="Clear all measurements" AutomationProperties.AutomationId="ClearButton">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE894;" Margin="0,0,8,0" />
            <TextBlock Text="Clear" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding ExportReportCommand}" Margin="12,0,0,0" Padding="14,6"
                ToolTip="Export the results as a CSV report (Ctrl+E)" AutomationProperties.AutomationId="ExportButton">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" Margin="0,0,8,0" />
            <TextBlock Text="Export report" />
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,14,0">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="20" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="ANOVA" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Caption}" Text="One-factor analysis of variance and contrasts" />
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="420" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="6*" MinWidth="480" />
      </Grid.ColumnDefinitions>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Measurements -->
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
              <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" VerticalAlignment="Center"
                      Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                      Visibility="{Binding FileName, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource Caption}" Text="{Binding FileName}" />
              </Border>
              <TextBlock Style="{StaticResource CardTitle}" Text="Measurements" Margin="0" VerticalAlignment="Center" />
            </DockPanel>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Style="{StaticResource FieldLabel}" Text="Alternatives" Margin="0,0,12,0" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource StepperButton}" Content="&#xE738;" Command="{Binding RemoveAlternativeCommand}" AutomationProperties.Name="Fewer alternatives" />
                <TextBlock Text="{Binding AlternativeCount}" MinWidth="34" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
                <Button Style="{StaticResource StepperButton}" Content="&#xE710;" Command="{Binding AddAlternativeCommand}" AutomationProperties.Name="More alternatives" AutomationProperties.AutomationId="AddAlternative" />
              </StackPanel>

              <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Measurements each" Margin="0,0,12,0" />
              <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Style="{StaticResource StepperButton}" Content="&#xE738;" Command="{Binding RemoveMeasurementCommand}" AutomationProperties.Name="Fewer measurements" />
                <TextBlock Text="{Binding MeasurementCount}" MinWidth="34" TextAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
                <Button Style="{StaticResource StepperButton}" Content="&#xE710;" Command="{Binding AddMeasurementCommand}" AutomationProperties.Name="More measurements" AutomationProperties.AutomationId="AddMeasurement" />
              </StackPanel>
            </Grid>

            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,12,0,0"
                       Text="Click a name to rename an alternative. Paste cells from Excel, or drop a CSV file onto the window." />

            <DataGrid x:Name="MeasurementGrid"
                      AutomationProperties.AutomationId="MeasurementGrid"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                      SelectionUnit="Cell" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="36" ColumnHeaderHeight="44" />
          </DockPanel>
        </Border>

        <!-- Effects -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" DataContext="{Binding Summary}"
                Visibility="{Binding Converter={StaticResource VisibleWhen}}">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Bottom">
                <Run Text="Grand mean" /> <Run Text="{Binding GrandMeanText, Mode=OneWay}" FontWeight="SemiBold" />
              </TextBlock>
              <TextBlock Style="{StaticResource CardTitle}" Text="Effects of the alternatives" Margin="0" />
            </DockPanel>
            <!-- Columns match the name, bar and mean areas of EffectChart. -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="64" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="below the grand mean ◀  ▶ above it" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="Mean" HorizontalAlignment="Right" />
            </Grid>
            <controls:EffectChart Items="{Binding Effects}"
                                  PositiveBrush="{StaticResource PositiveBarBrush}"
                                  NegativeBrush="{StaticResource NegativeBarBrush}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  SecondaryForeground="{DynamicResource TextFillColorSecondaryBrush}"
                                  AxisBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Results -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel>

          <!-- Empty state -->
          <Border Style="{StaticResource Card}" Padding="28,40"
                  Visibility="{Binding HasResult, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="40" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <TextBlock Text="No results yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6" />
              <TextBlock Style="{StaticResource Caption}" Text="{Binding Status}" TextAlignment="Center" MaxWidth="360"
                         AutomationProperties.AutomationId="StatusText" />
            </StackPanel>
          </Border>

          <StackPanel Visibility="{Binding HasResult, Converter={StaticResource VisibleWhen}}">

            <!-- F-test -->
            <Border Style="{StaticResource Card}" DataContext="{Binding Summary}">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Confidence" Margin="0,0,10,0" />
                    <ComboBox Style="{StaticResource ConfidenceBox}"
                              DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                              ItemsSource="{Binding ConfidencePresets}"
                              Text="{Binding AnovaConfidenceText, UpdateSourceTrigger=PropertyChanged}"
                              Tag="{Binding HasAnovaConfidenceError}"
                              AutomationProperties.AutomationId="AnovaConfidence" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource CardTitle}" Text="F-test" Margin="0" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Style="{StaticResource ErrorText}" Text="{x:Static vm:MainViewModel.ConfidenceHint}"
                           Visibility="{Binding DataContext.HasAnovaConfidenceError, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                <Border Style="{StaticResource Verdict}">
                  <DockPanel>
                    <TextBlock Style="{StaticResource VerdictIcon}" />
                    <StackPanel>
                      <TextBlock Text="{Binding Verdict}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="AnovaVerdict" />
                      <TextBlock Style="{StaticResource Caption}" Text="{Binding VerdictDetail}" Margin="0,2,0,0" />
                    </StackPanel>
                  </DockPanel>
                </Border>

                <UniformGrid Columns="4" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="F computed" />
                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding FText}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="F critical" />
                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding FCriticalText}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="p-value" />
                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding PValueText}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Explained by alternatives" />
                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding ExplainedText}" />
                  </StackPanel>
                </UniformGrid>

                <DataGrid ItemsSource="{Binding Table}" Margin="0,18,0,0"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          CanUserSortColumns="False" CanUserResizeColumns="False" CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal" SelectionMode="Single" IsHitTestVisible="False"
                          RowHeight="32">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="1.3*" ElementStyle="{StaticResource TableCellText}" />
                    <DataGridTextColumn Header="Sum of squares" Binding="{Binding SumOfSquares}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                    <DataGridTextColumn Header="df" Binding="{Binding DegreesOfFreedom}" Width="0.5*" ElementStyle="{StaticResource TableCellText}" />
                    <DataGridTextColumn Header="Mean square" Binding="{Binding MeanSquare}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                    <DataGridTextColumn Header="F" Binding="{Binding F}" Width="0.8*" ElementStyle="{StaticResource TableCellText}" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <!-- Contrast -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Contrast between two alternatives" />

                <WrapPanel Margin="0,0,0,14">
                  <ComboBox Width="150" ItemsSource="{Binding Alternatives}" SelectedItem="{Binding ContrastA}" DisplayMemberPath="Name"
                            AutomationProperties.AutomationId="ContrastA" />
                  <TextBlock Style="{StaticResource FieldLabel}" Text="versus" Margin="12,0" />
                  <ComboBox Width="150" ItemsSource="{Binding Alternatives}" SelectedItem="{Binding ContrastB}" DisplayMemberPath="Name"
                            AutomationProperties.AutomationId="ContrastB" />
                  <TextBlock Style="{StaticResource FieldLabel}" Text="at" Margin="12,0" />
                  <ComboBox Style="{StaticResource ConfidenceBox}"
                            ItemsSource="{Binding ConfidencePresets}"
                            Text="{Binding ContrastConfidenceText, UpdateSourceTrigger=PropertyChanged}"
                            Tag="{Binding HasContrastConfidenceError}"
                            AutomationProperties.AutomationId="ContrastConfidence" />
                </WrapPanel>

                <TextBlock Style="{StaticResource ErrorText}" Text="{x:Static vm:MainViewModel.ConfidenceHint}"
                           Visibility="{Binding HasContrastConfidenceError, Converter={StaticResource VisibleWhen}}" />

                <TextBlock Style="{StaticResource Caption}" Text="Pick two different alternatives."
                           Visibility="{Binding Contrast, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />

                <StackPanel DataContext="{Binding Contrast}"
                            Visibility="{Binding Converter={StaticResource VisibleWhen}}">
                  <Border Style="{StaticResource Verdict}">
                    <DockPanel>
                      <TextBlock Style="{StaticResource VerdictIcon}" />
                      <StackPanel>
                        <TextBlock Text="{Binding Verdict}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ContrastVerdict" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding VerdictDetail}" Margin="0,2,0,0" />
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <UniformGrid Columns="4" Margin="0,16,0,8">
                    <StackPanel>
                      <TextBlock Style="{StaticResource Caption}" Text="{Binding Title}" />
                      <TextBlock Style="{StaticResource MetricValue}" Text="{Binding EstimateText}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Style="{StaticResource Caption}" Text="Standard error" />
                      <TextBlock Style="{StaticResource MetricValue}" Text="{Binding StandardErrorText}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Style="{StaticResource Caption}" Text="t critical" />
                      <TextBlock Style="{StaticResource MetricValue}" Text="{Binding TCriticalText}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Style="{StaticResource Caption}" Text="Confidence interval" />
                      <TextBlock Style="{StaticResource MetricValue}" Text="{Binding IntervalText}" FontSize="16" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </UniformGrid>

                  <controls:IntervalPlot Lower="{Binding Result.Interval.Lower}"
                                         Upper="{Binding Result.Interval.Upper}"
                                         Estimate="{Binding Result.Estimate}"
                                         IntervalBrush="{StaticResource PositiveBarBrush}"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                         SecondaryForeground="{DynamicResource TextFillColorSecondaryBrush}"
                                         AxisBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
